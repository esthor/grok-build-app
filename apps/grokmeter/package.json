{
  "name": "grokmeter",
  "version": "0.1.0",
  "description": "Rainmeter-inspired desktop telemetry deck for Grok Build — cyberpunk widgets for your coding agent and your machine.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "demo": "GROKMETER_DEMO=1 bun --hot src/server.ts",
    "check": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  }
}
