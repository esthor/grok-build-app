{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grokamp",
  "version": "0.1.0",
  "identifier": "ai.grokamp.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grokamp — it really whips the token stream",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
